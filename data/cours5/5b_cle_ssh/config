# Fichier de secours pour .ssh/config : GitHub en SSH par le port 443.
# À copier dans C:\Users\<vous>\.ssh\ seulement si le port 22 est fermé.
#
#     copy config %USERPROFILE%\.ssh\config
#
# Source : docs.github.com, « Using SSH over the HTTPS port ».

Host github.com
    Hostname ssh.github.com
    Port 443
    User git
